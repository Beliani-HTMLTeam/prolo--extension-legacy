{
  "author": {
    "email": "demczenko@beliani.co.uk"
  },
  "name": "Prolo power tool-DEVMODE 2",
  "version": "2.0.0",
  "manifest_version": 3,
  "description": "Make prolo great again!",
  "default_locale": "en",
  "icons": {
    "32": "./icons/copy-32.png",
    "64": "./icons/copy-64.png",
    "128": "./icons/copy-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://prolodev.prologistics.info/*",
        "https://www.prologistics.info/*",
        "https://www.prologistics.info/start.php"
      ],
      "js": ["./content/autoTimeStamp.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.prologistics.info/news_email.php?id=*&validate_message=*"
      ],
      "run_at": "document_idle",
      "js": ["./content/newsletterCheckPage.js"]
    },
    {
      "matches": [
        "https://www.prologistics.info/news_emails.php",
        "https://prolodev.prologistics.info/news_emails.php"
      ],
      "run_at": "document_idle",
      "css": ["./css/news_emails.css"],
      "js": [
        "./content/multiselect/index.js",
        "./content/multiselect/select.js"
      ]
    },
    {
      "matches": ["https://www.prologistics.info/start.php"],
      "js": [
        "./content/linkifyjs/linkify.js",
        "./content/linkifyjs/linkify-html.min.js",
        "./content/issue/nltrChecklistMap.bundle.js",
        "./content/start.php/issue.js"
      ],
      "css": ["./content/start.php/start_php.css"]
    },
    {
      "matches": [
        "https://www.prologistics.info/react/logs/issue_logs/*",
        "https://prolodev.prologistics.info/react/logs/issue_logs/*"
      ],
      "js": [
        "./content/emoji/content.js",
        "./content/issue/checklist-highlighter.js",
        "./content/issue/betterComments/styles.js"
      ],
      "run_at": "document_idle",
      "css": [
        "./content/emoji/styles.css"
      ]
    },
    {
      "matches": [
        "https://www.prologistics.info/react/logs/issue_logs/*",
        "https://prolodev.prologistics.info/react/logs/issue_logs/*"
      ],
      "css": ["./content/issue/betterComments/issue_styles.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.prologistics.info/spam_plan.php*",
        "https://prolodev.prologistics.info/spam_plan.php*"
      ],
      "js": [
        "./libraries/sweetalert2.min.js",
        "./content/planning/subjectLineDB.js",
        "./content/planning/planning-ui.js",
        "./content/cgb_templates/loader.js",
        "./content/planning/spam_plan.js",
        "./content/planning/planningDate.js"
      ],
      "css": ["./libraries/sweetalert2.min.css", "./content/planning/style.css"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset",
        "enabled": true,
        "path": "rule.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/start.php/start_php.css",
        "content/startphp_styles.css",
        "content/linkifyjs/*.js",
        "content/start.php/svg/*"
      ],
      "matches": [
        "https://www.prologistics.info/*",
        "https://prolodev.prologistics.info/*"
      ]
    }
  ],
  "permissions": ["declarativeNetRequest"]
}
